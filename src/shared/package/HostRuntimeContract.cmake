include_guard(GLOBAL)
function(zto_install_sdk_metadata kind)
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../.." ABSOLUTE)
    file(GLOB_RECURSE inputs LIST_DIRECTORIES false
        "${root}/src/${kind}/api/*" "${root}/src/shared/package/*" "${root}/src/shared/include/*")
    list(APPEND inputs "${root}/src/shared/CMakeLists.txt" "${root}/cmake/Version.cmake")
    list(SORT inputs)
    set(entries "")
    foreach(path IN LISTS inputs)
        file(SHA256 "${path}" hash)
        file(RELATIVE_PATH relative "${root}" "${path}")
        list(APPEND entries "{\"path\":\"${relative}\",\"sha256\":\"${hash}\"}")
    endforeach()
    list(JOIN entries "," records)
    install(CODE "set(ZTO_SDK_SOURCE_MANIFEST [==[[${records}]]==])\ninclude(\"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/InstallSdkMetadata.cmake\")")
endfunction()
set(ZTO_CLIENT_HOST_QT_MODULES Core Gui Network Qml Quick QuickControls2 Widgets Concurrent)
set(ZTOHUB_HOST_QT_MODULES Core Network)
function(zto_host_runtime_contract kind out_variable)
    if(kind STREQUAL "client")
        set(modules ${ZTO_CLIENT_HOST_QT_MODULES})
    else()
        set(modules ${ZTOHUB_HOST_QT_MODULES})
    endif()
    find_package(Qt6 REQUIRED COMPONENTS ${modules})
    set(output "${CMAKE_CURRENT_BINARY_DIR}/host-runtime-contract")
    file(MAKE_DIRECTORY "${output}")
    if(MSVC)
        math(EXPR major "${MSVC_VERSION} / 100")
        set(abi "msvc-${major}")
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        string(REGEX MATCH "^[0-9]+" major "${CMAKE_CXX_COMPILER_VERSION}")
        set(abi "gcc-${major}")
    else()
        string(REGEX MATCH "^[0-9]+" major "${CMAKE_CXX_COMPILER_VERSION}")
        set(abi "clang-${major}")
    endif()
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64)$" OR CMAKE_GENERATOR_PLATFORM STREQUAL "x64")
        set(arch x86_64)
    else()
        set(arch "${CMAKE_SYSTEM_PROCESSOR}")
    endif()
    if(WIN32)
        get_target_property(core Qt6::Core IMPORTED_LOCATION_RELEASE)
        get_filename_component(bin "${core}" DIRECTORY)
        list(JOIN modules "," module_list)
        foreach(config Release Debug)
            execute_process(COMMAND powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass
                -File "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/GenerateHostContract.ps1"
                -QtBin "${bin}" -Modules "${module_list}" -Output "${output}/${config}.json"
                -QtVersion "${Qt6_VERSION}" -Architecture "${arch}" -CompilerAbi "${abi}"
                -Configuration "${config}" -HostKind "${kind}" RESULT_VARIABLE result)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "Cannot compute original Qt Kit runtime contract (${config})")
            endif()
        endforeach()
    else()
        set(libraries "")
        set(records "")
        foreach(module IN LISTS modules)
            get_target_property(location Qt6::${module} IMPORTED_LOCATION_RELEASE)
            if(NOT location)
                get_target_property(location Qt6::${module} IMPORTED_LOCATION_NONE)
            endif()
            get_filename_component(name "${location}" NAME)
            file(SHA256 "${location}" hash)
            list(APPEND libraries "\"${name}\"")
            list(APPEND records "${name}:${hash}")
        endforeach()
        list(SORT records)
        list(JOIN records "\n" signature)
        string(SHA256 build_id "${signature}")
        list(JOIN libraries "," names)
        string(TOLOWER "${CMAKE_SYSTEM_NAME}" platform)
        if(APPLE)
            set(platform macos)
        endif()
        foreach(config Release Debug)
            if(config STREQUAL "Debug")
                set(debug true)
            else()
                set(debug false)
            endif()
            file(WRITE "${output}/${config}.json" "{\"formatVersion\":1,\"host\":\"${kind}\",\"platform\":\"${platform}\",\"architecture\":\"${arch}\",\"compilerAbi\":\"${abi}\",\"debug\":${debug},\"qtVersion\":\"${Qt6_VERSION}\",\"baseLibraries\":[${names}],\"qtBuildId\":\"${build_id}\"}")
        endforeach()
    endif()
    set(${out_variable} "${output}" PARENT_SCOPE)
endfunction()
function(zto_embed_host_contract target directory)
    foreach(config Release Debug)
        set_source_files_properties("${directory}/${config}.json" PROPERTIES QT_RESOURCE_ALIAS "${config}.json")
    endforeach()
    qt_add_resources(${target} host_contract PREFIX "/zto/contracts" FILES "${directory}/Release.json" "${directory}/Debug.json")
endfunction()
