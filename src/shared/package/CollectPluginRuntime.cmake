include("${INPUT}")
file(LOCK "${OUTPUT}.lock" GUARD PROCESS TIMEOUT 180)
if(WIN32)
    # Mappings are passed through a JSON parameter file; paths may contain spaces.
    string(REPLACE "\\" "/" ENTRY "${ENTRY}")
    string(REPLACE "\\" "/" OUTPUT "${OUTPUT}")
    string(REPLACE "\\" "/" CONTRACT "${CONTRACT}")
    string(REPLACE "\\" "/" QT_ROOT "${QT_ROOT}")
    set(request "${OUTPUT}.request.json")
    function(json_array variable values)
        set(items "")
        foreach(item IN LISTS values)
            string(REPLACE "\\" "/" item "${item}")
            string(REPLACE "\"" "\\\"" item "${item}")
            list(APPEND items "\"${item}\"")
        endforeach()
        list(JOIN items "," array)
        set(${variable} "[${array}]" PARENT_SCOPE)
    endfunction()
    json_array(modules "${RUNTIME_QT_MODULES}")
    json_array(types "${RUNTIME_PLUGIN_TYPES}")
    json_array(runtime "${RUNTIME_FILES}")
    json_array(licenses "${LICENSE_FILES}")
    file(WRITE "${request}" "{\"entry\":\"${ENTRY}\",\"output\":\"${OUTPUT}\",\"contract\":\"${CONTRACT}\",\"qtRoot\":\"${QT_ROOT}\",\"configuration\":\"${CONFIGURATION}\",\"modules\":${modules},\"pluginTypes\":${types},\"runtime\":${runtime},\"licenses\":${licenses}}")
    execute_process(COMMAND powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass
        -File "${CMAKE_CURRENT_LIST_DIR}/CollectPluginRuntime.ps1" -Request "${request}"
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Runtime collection failed; previous package was not published")
    endif()
    set(manifest "${OUTPUT}.bundle.json")
else()
    if(RUNTIME_QT_MODULES OR RUNTIME_FILES)
        message(FATAL_ERROR "Private runtime deployment is not supported on this platform")
    endif()
    get_filename_component(extension "${ENTRY}" LAST_EXT)
    string(REPLACE "\\" "/" ENTRY "${ENTRY}")
    set(files "{\"path\":\"plugin/plugin${extension}\",\"role\":\"entry\",\"source\":\"${ENTRY}\"}")
    foreach(mapping IN LISTS LICENSE_FILES)
        string(FIND "${mapping}" "=" equals)
        if(equals LESS 1)
            message(FATAL_ERROR "Expected package/path=source license mapping")
        endif()
        string(SUBSTRING "${mapping}" 0 ${equals} path)
        math(EXPR start "${equals}+1")
        string(SUBSTRING "${mapping}" ${start} -1 source)
        if(NOT EXISTS "${source}" OR IS_SYMLINK "${source}")
            message(FATAL_ERROR "License missing or linked: ${source}")
        endif()
        string(APPEND files ",{\"path\":\"${path}\",\"role\":\"license\",\"source\":\"${source}\"}")
    endforeach()
    set(manifest "${OUTPUT}.bundle.json")
    file(WRITE "${manifest}" "{\"files\":[${files}],\"runtime\":{},\"requiresHost\":[]}")
endif()
execute_process(COMMAND "${TOOL}" --bundle-manifest "${manifest}" --output "${OUTPUT}"
    --host "${HOST}" --id "${ID}" --name "${NAME}" --version "${VERSION}" --apiVersion "${API}" --iid "${IID}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Plugin packaging failed (${result}); no new package published. Tool: ${TOOL}")
endif()
get_filename_component(name "${OUTPUT}" NAME_WE)
# Retain readable license copies beside build artifacts on every platform.
if(NOT WIN32)
foreach(mapping IN LISTS LICENSE_FILES)
    string(FIND "${mapping}" "=" equals)
    string(SUBSTRING "${mapping}" 0 ${equals} path)
    math(EXPR start "${equals}+1")
    string(SUBSTRING "${mapping}" ${start} -1 source)
    get_filename_component(leaf "${path}" NAME)
    get_filename_component(outdir "${OUTPUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${outdir}/${name}-licenses")
    file(COPY_FILE "${source}" "${outdir}/${name}-licenses/${leaf}")
endforeach()
else()
    execute_process(COMMAND powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass
        -File "${CMAKE_CURRENT_LIST_DIR}/CollectPluginRuntime.ps1" -Request "${request}" -Cleanup
        RESULT_VARIABLE cleanup)
    if(NOT cleanup EQUAL 0)
        message(FATAL_ERROR "Cannot clean owned packaging staging")
    endif()
endif()
