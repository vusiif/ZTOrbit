include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/HostRuntimeContract.cmake")
function(ztgui_package_plugin target)
    cmake_parse_arguments(PACK "" "HOST;ID;NAME;VERSION;API;IID" "RUNTIME_QT_MODULES;RUNTIME_FILES;LICENSE_FILES" ${ARGN})
    if(PACK_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "Unknown packaging arguments: ${PACK_UNPARSED_ARGUMENTS}")
    endif()
    if(TARGET ztplugin_pack)
        set(ZTGUI_PACKAGE_TOOL "$<TARGET_FILE:ztplugin_pack>")
        add_dependencies(${target} ztplugin_pack)
    endif()
    if(NOT ZTGUI_PACKAGE_TOOL)
        message(FATAL_ERROR "SDK package tool is unavailable")
    endif()
    if((PACK_RUNTIME_QT_MODULES OR PACK_RUNTIME_FILES) AND NOT WIN32)
        message(FATAL_ERROR "Private Qt module deployment supports Windows only; Linux client/macOS media deployment is unverified")
    endif()
    if(NOT ZTGUI_HOST_CONTRACT_DIRECTORY)
        message(FATAL_ERROR "SDK host runtime contract is missing; update the SDK first")
    endif()
    set(PACK_RUNTIME_PLUGIN_TYPES "")
    foreach(module IN LISTS PACK_RUNTIME_QT_MODULES)
        find_package(Qt6 REQUIRED COMPONENTS ${module})
        get_target_property(types Qt6::${module} MODULE_PLUGIN_TYPES)
        if(types)
            list(APPEND PACK_RUNTIME_PLUGIN_TYPES ${types})
        endif()
    endforeach()
    list(REMOVE_DUPLICATES PACK_RUNTIME_PLUGIN_TYPES)
    get_target_property(qt_core Qt6::Core IMPORTED_LOCATION_RELEASE)
    get_filename_component(qt_bin "${qt_core}" DIRECTORY)
    get_filename_component(qt_root "${qt_bin}" DIRECTORY)
    set(config "$<IF:$<BOOL:$<CONFIG>>,$<CONFIG>,Release>")
    # RelWithDebInfo/MinSizeRel use the release Qt Kit.
    set(contract_config "$<IF:$<CONFIG:Debug>,Debug,Release>")
    set(input "${CMAKE_CURRENT_BINARY_DIR}/${target}-bundle-${config}.cmake")
    set(script "set(ENTRY [==[$<TARGET_FILE:${target}>]==])\nset(OUTPUT [==[$<TARGET_FILE_DIR:${target}>/${target}.ztplugin]==])\n")
    foreach(key HOST ID NAME VERSION API IID RUNTIME_QT_MODULES RUNTIME_PLUGIN_TYPES RUNTIME_FILES LICENSE_FILES)
        string(APPEND script "set(${key} [==[${PACK_${key}}]==])\n")
    endforeach()
    string(APPEND script "set(TOOL [==[${ZTGUI_PACKAGE_TOOL}]==])\nset(QT_ROOT [==[${qt_root}]==])\nset(CONFIGURATION [==[${contract_config}]==])\nset(CONTRACT [==[${ZTGUI_HOST_CONTRACT_DIRECTORY}/${contract_config}.json]==])\n")
    file(GENERATE OUTPUT "${input}" CONTENT "${script}")
    set(collector "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CollectPluginRuntime.cmake")
    set(command ${CMAKE_COMMAND} "-DINPUT=${input}" -P "${collector}")
    add_custom_command(TARGET ${target} POST_BUILD COMMAND ${command} VERBATIM)
    # POST_BUILD and explicit target share a file lock in the collector.
    add_custom_target(${target}_package COMMAND ${command} DEPENDS ${target} VERBATIM)
    install(DIRECTORY "$<TARGET_FILE_DIR:${target}>/${target}-licenses/" DESTINATION "plugins/licenses/${target}" OPTIONAL)
endfunction()
