# Invoked by SDK install after every installed runtime/tool file exists.
file(GLOB_RECURSE installed RELATIVE "${CMAKE_INSTALL_PREFIX}" "${CMAKE_INSTALL_PREFIX}/*")
list(SORT installed)
set(records "")
set(files "")
foreach(relative IN LISTS installed)
    if(IS_DIRECTORY "${CMAKE_INSTALL_PREFIX}/${relative}" OR relative STREQUAL "sdk-tools.json")
        continue()
    endif()
    file(SHA256 "${CMAKE_INSTALL_PREFIX}/${relative}" hash)
    list(APPEND records "${relative}:${hash}")
    list(APPEND files "{\"path\":\"${relative}\",\"sha256\":\"${hash}\"}")
endforeach()
list(JOIN records "\n" signature)
string(SHA256 fingerprint "${signature}")
list(JOIN files "," entries)
file(WRITE "${CMAKE_INSTALL_PREFIX}/sdk-tools.json" "{\"packageFormats\":[1,2,3],\"toolFingerprint\":\"${fingerprint}\",\"files\":[${entries}],\"sources\":${ZTGUI_SDK_SOURCE_MANIFEST}}\n")
