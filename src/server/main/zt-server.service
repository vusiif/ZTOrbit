[Unit]
Description=ZeroTier plugin server
After=network-online.target zerotier-one.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Server/ZTServer
ExecStart=/root/Server/ZTServer/zt-server --server --listen 0.0.0.0 --port 18100
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
