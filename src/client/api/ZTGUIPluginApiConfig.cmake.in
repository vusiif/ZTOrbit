@PACKAGE_INIT@
set(_ztgui_sdk_prefix "${PACKAGE_PREFIX_DIR}")
set(ZTGUI_API_VERSION "@ZTGUI_API_VERSION@")
include(CMakeFindDependencyMacro)
if(ZTGUIPluginApi_FIND_COMPONENTS STREQUAL "Services")
    find_dependency(Qt6 6.8 COMPONENTS Core Network)
else()
    find_dependency(Qt6 6.8 COMPONENTS Quick Qml Network)
endif()
set(ZTGUIPluginApi_Services_FOUND TRUE)
include("${CMAKE_CURRENT_LIST_DIR}/ZTGUIPluginApiTargets.cmake")
check_required_components(ZTGUIPluginApi)

set(ZTGUI_PACKAGE_TOOL "${_ztgui_sdk_prefix}/bin/ztplugin_pack@CMAKE_EXECUTABLE_SUFFIX@")
set(ZTGUI_HOST_CONTRACT_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/contracts")
set(ZTGUI_PACKAGE_FORMATS 1 2 3)
include("${CMAKE_CURRENT_LIST_DIR}/PackagePlugin.cmake")
