get_filename_component(ZTGUI_SERVER_OLD_REPOSITORY "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${ZTGUI_SERVER_OLD_REPOSITORY}/VERSION")
file(READ "${ZTGUI_SERVER_OLD_REPOSITORY}/VERSION" ZEROTIER_VERSION)
string(STRIP "${ZEROTIER_VERSION}" ZEROTIER_VERSION)
if(NOT ZEROTIER_VERSION MATCHES "^0\\.([0-9]+)\\.[0-9]+$")
    message(FATAL_ERROR "Archived C++ server VERSION must be 0.core.patch")
endif()
set(ZEROTIER_VERSION_NUMERIC "${ZEROTIER_VERSION}")
set(ZTGUI_API_VERSION "0.${CMAKE_MATCH_1}")
set(ZTGUI_API_VERSION_NUMERIC "${ZTGUI_API_VERSION}")
