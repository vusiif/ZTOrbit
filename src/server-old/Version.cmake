get_filename_component(ZTOHUB_OLD_REPOSITORY "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${ZTOHUB_OLD_REPOSITORY}/VERSION")
file(READ "${ZTOHUB_OLD_REPOSITORY}/VERSION" ZTO_VERSION)
string(STRIP "${ZTO_VERSION}" ZTO_VERSION)
if(NOT ZTO_VERSION MATCHES "^0\\.([0-9]+)\\.[0-9]+$")
    message(FATAL_ERROR "Archived C++ server VERSION must be 0.core.patch")
endif()
set(ZTO_VERSION_NUMERIC "${ZTO_VERSION}")
set(ZTO_API_VERSION "0.${CMAKE_MATCH_1}")
set(ZTO_API_VERSION_NUMERIC "${ZTO_API_VERSION}")
