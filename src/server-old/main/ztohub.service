[Unit]
Description=ZTOrbitHub plugin server
After=network-online.target zerotier-one.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Server/ZTOrbitHub
ExecStart=/root/Server/ZTOrbitHub/start-server.sh --server --listen 0.0.0.0 --port 18100
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
