include_guard(GLOBAL)
if(NOT MEDIA_FFMPEG_ROOT)
    message(FATAL_ERROR "MEDIA_FFMPEG_ROOT must point to the controlled FFmpeg development SDK")
endif()
file(TO_CMAKE_PATH "${MEDIA_FFMPEG_ROOT}" MEDIA_FFMPEG_ROOT)
set(MEDIA_FFMPEG_COMPONENTS avutil avcodec avformat avdevice avfilter swscale swresample)
set(_fingerprint "engine=1;ffmpeg=7.1.5;")
foreach(component IN LISTS MEDIA_FFMPEG_COMPONENTS)
    unset(MEDIA_${component}_INCLUDE CACHE)
    unset(MEDIA_${component}_LIB CACHE)
    find_path(MEDIA_${component}_INCLUDE lib${component}/version.h PATHS "${MEDIA_FFMPEG_ROOT}/include" NO_DEFAULT_PATH REQUIRED)
    find_library(MEDIA_${component}_LIB NAMES ${component} PATHS "${MEDIA_FFMPEG_ROOT}/lib" NO_DEFAULT_PATH REQUIRED)
    file(GLOB _dll "${MEDIA_FFMPEG_ROOT}/bin/${component}-*.dll")
    list(LENGTH _dll _count)
    if(NOT _count EQUAL 1)
        message(FATAL_ERROR "Expected exactly one controlled ${component} DLL")
    endif()
    file(SHA256 "${_dll}" _hash)
    string(APPEND _fingerprint "${component}=${_hash};")
    if(NOT TARGET FFmpeg::${component})
        add_library(FFmpeg::${component} SHARED IMPORTED GLOBAL)
        set_target_properties(FFmpeg::${component} PROPERTIES IMPORTED_IMPLIB "${MEDIA_${component}_LIB}" IMPORTED_LOCATION "${_dll}" INTERFACE_INCLUDE_DIRECTORIES "${MEDIA_FFMPEG_ROOT}/include")
    endif()
    list(APPEND MEDIA_FFMPEG_DLLS "${_dll}")
endforeach()
string(SHA256 MEDIA_FFMPEG_FINGERPRINT "${_fingerprint}")
