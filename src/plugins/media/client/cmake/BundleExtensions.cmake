set(MEDIA_EXTENSION_BUNDLE "" CACHE FILEPATH "Prebuilt worker extension bundle manifest")
set(extension_resources "extensions/flip/$<TARGET_FILE_NAME:ztmedia_flip>=$<TARGET_FILE:ztmedia_flip>")
set(extension_manifest "[{\"path\":\"extensions/flip/$<TARGET_FILE_NAME:ztmedia_flip>\",\"abi\":1,\"ffmpeg\":\"${MEDIA_FFMPEG_FINGERPRINT}\"}]")
if(MEDIA_EXTENSION_BUNDLE)
    file(READ "${MEDIA_EXTENSION_BUNDLE}" bundle)
    string(JSON count LENGTH "${bundle}")
    get_filename_component(bundle_root "${MEDIA_EXTENSION_BUNDLE}" DIRECTORY)
    set(extension_manifest "[")
    set(extension_resources "")
    set(paths "")
    if(count GREATER 0)
        math(EXPR last "${count}-1")
        foreach(index RANGE 0 ${last})
            string(JSON source GET "${bundle}" ${index} source)
            string(JSON path GET "${bundle}" ${index} path)
            if(NOT path MATCHES "^extensions/[A-Za-z0-9._/-]+\\.dll$" OR path MATCHES "(^|/)\\.\\.?(/|$)" OR path IN_LIST paths)
                message(FATAL_ERROR "Invalid/duplicate extension package path: ${path}")
            endif()
            get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${bundle_root}")
            file(TO_CMAKE_PATH "${source}" source)
            if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}" OR IS_SYMLINK "${source}")
                message(FATAL_ERROR "Extension binary missing or linked: ${source}")
            endif()
            list(APPEND paths "${path}")
            list(APPEND extension_resources "${path}=${source}")
            if(index GREATER 0)
                string(APPEND extension_manifest ",")
            endif()
            string(APPEND extension_manifest "{\"path\":\"${path}\",\"abi\":1,\"ffmpeg\":\"${MEDIA_FFMPEG_FINGERPRINT}\"}")
        endforeach()
    endif()
    string(APPEND extension_manifest "]")
endif()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/$<CONFIG>/extensions.json" CONTENT "${extension_manifest}\n")
