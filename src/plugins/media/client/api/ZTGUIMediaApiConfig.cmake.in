@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.8 COMPONENTS Core)
include("${CMAKE_CURRENT_LIST_DIR}/ZTGUIMediaTypesTargets.cmake")
set(ZTGUIMediaApi_Types_FOUND TRUE)
if(NOT ZTGUIMediaApi_FIND_COMPONENTS STREQUAL "Types")
    if(NOT TARGET ZTGUI::Services)
        find_dependency(ZTGUIPluginApi 0.5 EXACT CONFIG COMPONENTS Services)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/ZTGUIMediaApiTargets.cmake")
    set(ZTGUIMediaApi_Api_FOUND TRUE)
endif()
if("Quick" IN_LIST ZTGUIMediaApi_FIND_COMPONENTS)
    find_dependency(Qt6 6.8 COMPONENTS Quick)
    include("${CMAKE_CURRENT_LIST_DIR}/ZTGUIMediaQuickTargets.cmake")
    set(ZTGUIMediaApi_Quick_FOUND TRUE)
endif()
check_required_components(ZTGUIMediaApi)
