@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.8 COMPONENTS Core)
include("${CMAKE_CURRENT_LIST_DIR}/ZTOrbitMediaTypesTargets.cmake")
set(ZTOrbitMediaApi_Types_FOUND TRUE)
if(NOT ZTOrbitMediaApi_FIND_COMPONENTS STREQUAL "Types")
    if(NOT TARGET ZTO::Services)
        find_dependency(ZTOrbitPluginApi 0.5 EXACT CONFIG COMPONENTS Services)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/ZTOrbitMediaApiTargets.cmake")
    set(ZTOrbitMediaApi_Api_FOUND TRUE)
endif()
if("Quick" IN_LIST ZTOrbitMediaApi_FIND_COMPONENTS)
    find_dependency(Qt6 6.8 COMPONENTS Quick)
    include("${CMAKE_CURRENT_LIST_DIR}/ZTOrbitMediaQuickTargets.cmake")
    set(ZTOrbitMediaApi_Quick_FOUND TRUE)
endif()
check_required_components(ZTOrbitMediaApi)
