get_filename_component(ZTGUI_REPOSITORY "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(ZTGUI_VERSION_FILE "${ZTGUI_REPOSITORY}/VERSION")
set(ZTGUI_SERVER_VERSION_FILE "${ZTGUI_REPOSITORY}/SERVER_VERSION")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${ZTGUI_VERSION_FILE}" "${ZTGUI_SERVER_VERSION_FILE}")
file(READ "${ZTGUI_VERSION_FILE}" ZEROTIER_VERSION)
file(READ "${ZTGUI_SERVER_VERSION_FILE}" ZTGUI_SERVER_VERSION_TEXT)
string(STRIP "${ZEROTIER_VERSION}" ZEROTIER_VERSION)
string(STRIP "${ZTGUI_SERVER_VERSION_TEXT}" ZTGUI_SERVER_VERSION_TEXT)

# Client version: 0.<core>.<patch>[-qualifier]. The client API uses the same
# core components and the same qualifier, so the two stay in lockstep.
if(NOT ZEROTIER_VERSION MATCHES "^0\\.([0-9]+)\\.([0-9]+)(-[0-9A-Za-z.-]+)?$")
    message(FATAL_ERROR "VERSION must be 0.<core>.<patch>[-qualifier]")
endif()
set(ZEROTIER_VERSION_NUMERIC "0.${CMAKE_MATCH_1}.${CMAKE_MATCH_2}")
set(ZEROTIER_VERSION_SUFFIX "${CMAKE_MATCH_3}")
set(ZTGUI_API_VERSION "0.${CMAKE_MATCH_1}${CMAKE_MATCH_3}")
set(ZTGUI_API_VERSION_NUMERIC "0.${CMAKE_MATCH_1}")

# Server version is specified on the client side in SERVER_VERSION. The server
# build reads the same file; it is not derived from the client VERSION.
if(NOT ZTGUI_SERVER_VERSION_TEXT MATCHES "^0\\.([0-9]+)\\.([0-9]+)(-[0-9A-Za-z.-]+)?$")
    message(FATAL_ERROR "SERVER_VERSION must be 0.<core>.<patch>[-qualifier]")
endif()
set(ZTGUI_SERVER_VERSION "${ZTGUI_SERVER_VERSION_TEXT}")
set(ZTGUI_SERVER_VERSION_NUMERIC "0.${CMAKE_MATCH_1}.${CMAKE_MATCH_2}")
set(ZTGUI_SERVER_VERSION_SUFFIX "${CMAKE_MATCH_3}")
set(ZTGUI_SERVER_API_VERSION "0.${CMAKE_MATCH_1}${CMAKE_MATCH_3}")
set(ZTGUI_SERVER_API_VERSION_NUMERIC "0.${CMAKE_MATCH_1}")
